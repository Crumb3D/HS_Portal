<configs>
	<append xpath="/nav_object_classes">

		<nav_object_class name="hsportalBlue">
			<map_settings>
				<property name="sprite_name" value="ui_game_symbol_map_waypoint_set"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="-1"/>
				<property name="color" value="70,170,255,255"/>
				<property name="has_pulse" value="true"/>
			</map_settings>
			<compass_settings>
				<property name="sprite_name" value="ui_game_symbol_map_waypoint_set"/>
				<property name="min_distance" value="0"/>
				<property name="max_scale_distance" value="1024"/>
				<property name="color" value="70,170,255,255"/>
				<property name="has_pulse" value="true"/>
				<property name="icon_clamped" value="true"/>
			</compass_settings>
		</nav_object_class>

		<nav_object_class name="hsportalOrange">
			<map_settings>
				<property name="sprite_name" value="ui_game_symbol_map_waypoint_set"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="-1"/>
				<property name="color" value="255,140,25,255"/>
				<property name="has_pulse" value="true"/>
			</map_settings>
			<compass_settings>
				<property name="sprite_name" value="ui_game_symbol_map_waypoint_set"/>
				<property name="min_distance" value="0"/>
				<property name="max_scale_distance" value="1024"/>
				<property name="color" value="255,140,25,255"/>
				<property name="has_pulse" value="true"/>
				<property name="icon_clamped" value="true"/>
			</compass_settings>
		</nav_object_class>

	</append>
</configs>
