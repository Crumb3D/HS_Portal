<configs>
	<append xpath="/items">

		<item name="hsportalHandbook">
			<property name="Extends" value="blankNoteMaster"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DescriptionKey" value="hsportalHandbookDesc"/>
			<property name="CustomIcon" value="questMaster"/>
			<property name="CustomIconTint" value="3d7eff"/>
			<property name="NoScrapping" value="true"/>
			<property name="Stacknumber" value="1"/>
			<property name="EconomicValue" value="10"/>
			<property name="SellableToTrader" value="false"/>
			<property name="SoundPickup" value="map_grab"/>
			<property name="SoundPlace" value="map_place"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical"/>
			<property class="Action0">
				<property name="Class" value="Eat"/>
				<property name="Consume" value="false"/>
				<property name="Delay" value="0.5"/>
				<property name="UseAnimation" value="false"/>
				<property name="Sound_start" value="read_mod"/>
				<property name="Sound_in_head" value="true"/>
				<property name="PromptTitle" value="hsportalHandbook"/>
				<property name="PromptDescription" value="hsportalHandbookText"/>
			</property>
		</item>

		<item name="hsportalGun">
			<property name="Tags" value="weapon,ranged,gun,noMods,holdBreathAiming,electricianSkill"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DisplayType" value="rangedGun"/>
			<property name="HoldType" value="1"/>
			<property name="Meshfile" value="#@modfolder:Resources/HSPortal.unity3d?PortalGun"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="CustomIcon" value="hsportalGun"/>
			<property name="Material" value="MHandGunParts"/>
			<property name="DescriptionKey" value="hsportalGunDesc"/>
			<property name="UnlockedBy" value="craftingElectrician"/>
			<property name="Stacknumber" value="1"/>
			<property name="DegradationBreaksAfter" value="false"/>
			<property name="EconomicValue" value="500"/>
			<property name="SellableToTrader" value="false"/>
			<property name="SoundUnholster" value="weapon_unholster"/>
			<property name="SoundHolster" value="weapon_holster"/>
			<property name="SoundPickup" value="pistol_grab"/>
			<property name="SoundPlace" value="pistol_place"/>
			<property class="Action0">
				<property name="Class" value="HSPortalGun, HSPortal"/>
			</property>
			<property class="Action1">
				<property name="Class" value="HSPortalGun, HSPortal"/>
			</property>
			<property name="Group" value="Ammo/Weapons,Ranged Weapons,Science,TCScience"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical"/>
		</item>

		<item name="hsportalGelGun">
			<property name="Tags" value="weapon,ranged,gun,noMods,holdBreathAiming,reloadPenalty,electricianSkill"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DisplayType" value="rangedGun"/>
			<property name="HoldType" value="1"/>
			<property name="Meshfile" value="#@modfolder:Resources/HSPortal.unity3d?GelGun"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="CustomIcon" value="hsportalGelGun"/>
			<property name="Material" value="MHandGunParts"/>
			<property name="DescriptionKey" value="hsportalGelGunDesc"/>
			<property name="UnlockedBy" value="craftingElectrician"/>
			<property name="Stacknumber" value="1"/>
			<property name="DegradationBreaksAfter" value="false"/>
			<property name="EconomicValue" value="400"/>
			<property name="SellableToTrader" value="false"/>
			<property name="SoundUnholster" value="weapon_unholster"/>
			<property name="SoundHolster" value="weapon_holster"/>
			<property name="SoundPickup" value="pistol_grab"/>
			<property name="SoundPlace" value="pistol_place"/>
			<property class="Action0">
				<property name="Class" value="HSPortalGelGun, HSPortal"/>
				<property name="Magazine_items" value="hsportalGoo"/>
				<property name="Magazine_size" value="8"/>
				<property name="Reload_time" value="1.4"/>
				<property name="Delay" value="0.11"/>
				<property name="Range" value="12"/>
				<property name="Sound_start" value="pistol_fire"/>
				<property name="Sound_loop" value=""/>
				<property name="Sound_end" value=""/>
				<property name="Sound_empty" value="dryfire"/>
				<property name="Sound_reload" value="pistol_reload"/>
				<property name="AutoReload" value="true"/>
				<property name="Show_ammo_force" value="true"/>
			</property>
			<property class="Action1">
				<property name="Class" value="HSPortalGelGun, HSPortal"/>
				<property name="Magazine_items" value="hsportalGoo"/>
				<property name="Magazine_size" value="8"/>
				<property name="Reload_time" value="1.4"/>
				<property name="Delay" value="0.11"/>
				<property name="Range" value="12"/>
				<property name="Sound_start" value="pistol_fire"/>
				<property name="Sound_loop" value=""/>
				<property name="Sound_end" value=""/>
				<property name="Sound_empty" value="dryfire"/>
				<property name="Sound_reload" value="pistol_reload"/>
				<property name="AutoReload" value="true"/>
				<property name="Show_ammo_force" value="true"/>
			</property>
			<effect_group name="hsportalGelGun" tiered="false">
				<passive_effect name="MagazineSize" operation="base_set" value="8"/>
				<passive_effect name="ModSlots" operation="base_set" value="0"/>
			</effect_group>
			<property name="Group" value="Ammo/Weapons,Ranged Weapons,Science,TCScience"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical"/>
		</item>

		<item name="hsportalGoo">
			<property name="Tags" value="ammo,hsportalGoo,electricianSkill,scrap100"/>
			<property name="DisplayType" value="ammoBullet"/>
			<property name="HoldType" value="45"/>
			<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="CustomIcon" value="hsportalGoo"/>
			<property name="Material" value="MresourceScrapPolymers"/>
			<property name="DescriptionKey" value="hsportalGooDesc"/>
			<property name="UnlockedBy" value="craftingElectrician"/>
			<property name="Stacknumber" value="200"/>
			<property name="EconomicValue" value="6"/>
			<property name="SellableToTrader" value="false"/>
			<property name="CreativeMode" value="Player"/>
			<property name="SoundPickup" value="water_grab"/>
			<property name="SoundPlace" value="water_place"/>
			<property name="Group" value="Ammo/Weapons,Ammo,Science,TCScience"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical"/>
		</item>

		<item name="hsportalBoots">
			<property name="Extends" value="armorLightMaster" param1="CustomIcon"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DescriptionKey" value="hsportalBootsDesc"/>
			<property name="DisplayType" value="hsportalBoots"/>
			<property name="CustomIcon" value="hsportalBoots"/>
			<property name="Tags" value="lowerbody,feet,armor,armorFeet,lightArmor,lightArmorDeg,armorLightSkill,electricianSkill"/>
			<property name="EquipSlot" value="Feet"/>
			<property name="UnlockedBy" value="craftingElectrician"/>
			<property name="SoundPickup" value="footwear_leather_grab"/>
			<property name="SoundPlace" value="footwear_leather_place"/>
			<property name="Group" value="Clothing,Armor,TCArmor,Science,TCScience"/>
			<property name="SellableToTrader" value="false"/>
			<property name="ShowQuality" value="true"/>
			<property name="EconomicValue" value="350"/>
			<property class="SDCS">
				<property name="Prefab" value="@:Entities/Player/{sex}/Gear/Biker/gear{sex}BikerPrefab.prefab"/>
				<property name="TransformName" value="feet"/>
				<property name="Excludes" value="feet"/>
			</property>
			<effect_group name="HSPortalBoots">
				<passive_effect name="ModSlots" operation="base_set" value="2,2,3,3,4,5" tier="1,2,3,4,5,6"/>
				<passive_effect name="ModPowerBonus" operation="base_add" value="300" tags="EconomicValue"/>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="8,12.3" tier="1,6"/>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="-.2,.2"/>
				<passive_effect name="ElementalDamageResist" operation="base_add" value="8,12.3" tier="1,6" tags="heat,electrical"/>
				<passive_effect name="ElementalDamageResist" operation="base_add" value="-.2,.2"/>
				<passive_effect name="BuffResistance" operation="base_add" value="0.041" tags="buffFatiguedTrigger,buffArmSprainedCHTrigger,buffLegSprainedCHTrigger,buffAbrasionCatch,buffLaceration,buffInfectionCatch,buffInjuryStunned01CHTrigger,buffInjuryBleedingTwo,buffInjuryBleedingBarbedWire"/>
				<passive_effect name="DegradationMax" operation="base_set" value="250,500" tier="1,6"/>
				<passive_effect name="DegradationPerUse" operation="base_set" value="1" tags="lightArmorDeg"/>
			</effect_group>
			<effect_group name="HSPortalBootsMove">
				<passive_effect name="RunSpeed" operation="perc_add" value=".02,.04,.06,.08,.1,.2" tier="1,2,3,4,5,6"/>
				<display_value name="dRunSpeed" value=".02,.04,.06,.08,.1,.2" tier="1,2,3,4,5,6"/>
			</effect_group>
			<effect_group name="HSPortalBootsFall" tiered="false">
				<requirement name="IsEquipped"/>
				<display_value name="dFallDamage" value="-1"/>
				<triggered_effect trigger="onSelfEquipStart" action="AddBuff" buff="buffHSPortalLongFall"/>
				<triggered_effect trigger="onSelfEquipStop" action="RemoveBuff" buff="buffHSPortalLongFall"/>
				<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$hsportalNoFall" operation="set" value="1"/>
				<triggered_effect trigger="onSelfEquipStop" action="ModifyCVar" cvar="$hsportalNoFall" operation="set" value="0"/>
			</effect_group>
		</item>

	</append>
</configs>
